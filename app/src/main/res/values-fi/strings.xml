    <string name="risk_blocked_scheme">Skeema voi suorittaa koodia</string>
    <string name="risk_blocked_scheme_body">Tämä osoite ei avaa sivua: se pyytää järjestelmää suorittamaan jotain. Signifer ei välitä sitä eteenpäin; sen voi kopioida ja tarkastella.</string>
    <string name="risk_unknown_scheme">Skeema ei ole listalla</string>
    <string name="risk_unknown_scheme_body">Avattavien skeemojen lista on suljettu. Kaikki, mikä ei ole listalla, estetään sen sijaan, että pidettäisiin kieltolistaa, joka on aina jäljessä huomenna ilmestyvästä.</string>
    <string name="risk_insecure_transport">Kulkee salaamattomana</string>
    <string name="risk_insecure_transport_body">Osoite alkaa http:llä eikä https:llä. Kuka tahansa samassa verkossa voi lukea ja muuttaa lähetettyä tietoa.</string>
    <string name="risk_embedded_credentials">Sisältää käyttäjätunnuksen ja salasanan</string>
    <string name="risk_embedded_credentials_body">Osoitteessa on kirjautumistiedot ennen palvelinta. Se on klassinen tapa naamioida osoite: @-merkkiä edeltävä osa ei ole määränpää.</string>
    <string name="risk_missing_host">Palvelinta ei ole annettu</string>
    <string name="risk_missing_host_body">Osoitteessa ei ole palvelinta, joten tarkistettavaa kohdetta ei ole.</string>
    <string name="risk_loopback_host">Osoittaa tähän puhelimeen</string>
    <string name="risk_loopback_host_body">Kohde on laite itse. Kadulle liimatulla koodilla ei ole mitään syytä pyytää sellaista.</string>
    <string name="risk_private_network">Osoittaa paikallisverkkoon</string>
    <string name="risk_private_network_body">Se johtaa laitteeseen siinä verkossa, johon olet juuri nyt yhteydessä: reitittimeen, kameraan tai hallintapaneeliin.</string>
    <string name="risk_raw_ip">Palvelin on numero eikä nimi</string>
    <string name="risk_raw_ip_body">IP-osoite verkkotunnuksen sijaan tekee mahdottomaksi tietää, kenen palvelin on.</string>
    <string name="risk_confusable_host">Palvelimen nimi voi olla naamioitu</string>
    <string name="risk_confusable_host_body">Se käyttää punycodea tai sekoittaa aakkostoja. Toisten kirjoitusjärjestelmien kirjaimet näyttävät täsmälleen latinalaisilta: kyrillinen ”а” osoitteessa apple.com näyttää samalta mutta vie muualle.</string>
    <string name="risk_excessive_subdomains">Ketjuttaa aliverkkotunnuksia</string>
    <string name="risk_excessive_subdomains_body">Pitkä nimi, jossa on paljon pisteitä, saa alun näyttämään oikealta verkkotunnukselta. Ratkaiseva on kuitenkin loppuosa.</string>
    <string name="risk_shortened">Todellinen kohde on piilossa</string>
    <string name="risk_shortened_body">Se on lyhytlinkki: näkyvä osoite ei ole se, johon päädyt. Signifer ei voi selvittää sitä ilman verkkoa, joten kohde näkyy vasta avattaessa.</string>
    <string name="risk_executable">Lataa jotain, joka asentuu tai käynnistyy</string>
    <string name="risk_executable_body">Linkki päättyy asennustiedostoon. Kadulle liimattu koodi, joka asentaa sovelluksen, on halvin huijaus, mitä on olemassa.</string>
    <string name="risk_bidirectional">Sisältää merkkejä, jotka kääntävät tekstin</string>
    <string name="risk_bidirectional_body">Näkymättömät merkit muuttavat järjestystä, jossa teksti luetaan. Niiden avulla asentuva tiedosto näyttää kuvalta.</string>
    <string name="risk_unusual_port">Kuuntelee epätavallisessa portissa</string>
    <string name="risk_unusual_port_body">Palvelin ei vastaa protokollan tavallisessa portissa.</string>
    <string name="risk_malformed">Osoite on virheellinen</string>
    <string name="risk_malformed_body">Palvelin tai portti ei ole kelvollinen, joten mikään selain ei voisi avata osoitetta. Yleensä kyse on rikkinäisestä koodista tai koodista, joka on tehty harhauttamaan.</string>
    <string name="warning_risky_destination">Kohteessa on havaintoja</string>
    <string name="warning_risky_destination_body">Jokainen niistä selitetään alla.</string>
    <string name="warning_unknown_network">Tämä on jonkun toisen verkko</string>
    <string name="warning_unknown_network_body">Verkon ylläpitäjä näkee kaiken salaamattoman liikenteen ja voi ohjata sen muualle.</string>
    <string name="warning_weak_network">Heikko salaus tai ei salausta</string>
    <string name="warning_weak_network_body">Avoin tai WEP-suojattu verkko ei suojaa mitään: kuka tahansa lähellä voi lukea, mitä sen kautta kulkee.</string>
