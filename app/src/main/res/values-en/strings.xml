    <string name="risk_blocked_scheme">The scheme can run code</string>
    <string name="risk_blocked_scheme_body">This address does not open a page: it asks the system to run something. Signifer does not hand it over; it can be copied and inspected.</string>
    <string name="risk_unknown_scheme">Scheme not on the list</string>
    <string name="risk_unknown_scheme_body">The list of schemes that may be opened is closed. Anything not on it is blocked, rather than keeping a list of banned ones that always trails whatever shows up tomorrow.</string>
    <string name="risk_insecure_transport">Travels unencrypted</string>
    <string name="risk_insecure_transport_body">It starts with http, not https. Anyone sharing the network can read and change what is sent.</string>
    <string name="risk_embedded_credentials">Carries a username and password</string>
    <string name="risk_embedded_credentials_body">The address includes credentials before the server. It is the classic way to disguise it: what comes before the at sign is not where you end up.</string>
    <string name="risk_missing_host">No server given</string>
    <string name="risk_missing_host_body">The address has no server, so there is no destination to check.</string>
    <string name="risk_loopback_host">Points at this very phone</string>
    <string name="risk_loopback_host_body">The destination is the device itself. A code stuck on a wall has no reason to ask for that.</string>
    <string name="risk_private_network">Points at the local network</string>
    <string name="risk_private_network_body">It leads to a machine on whichever network you are on right now: a router, a camera, an admin panel.</string>
    <string name="risk_raw_ip">The server is a number, not a name</string>
    <string name="risk_raw_ip_body">An IP address instead of a domain makes it impossible to tell whose server it is.</string>
    <string name="risk_confusable_host">The server name may be disguised</string>
    <string name="risk_confusable_host_body">It uses punycode or mixes alphabets. Letters from other scripts look identical to Latin ones: a Cyrillic «а» in apple.com looks the same and leads somewhere else.</string>
    <string name="risk_excessive_subdomains">Chains subdomains</string>
    <string name="risk_excessive_subdomains_body">A long name with many dots makes the beginning look like the real domain. The one that decides is the one at the end.</string>
    <string name="risk_shortened">The real destination is hidden</string>
    <string name="risk_shortened_body">It is a shortener: the address shown is not where you land. Signifer cannot resolve it because it has no network, so the destination only appears once opened.</string>
    <string name="risk_executable">Downloads something that installs or runs</string>
    <string name="risk_executable_body">The link ends in an installer file. A code stuck on a wall that installs an app is the cheapest fraud there is.</string>
    <string name="risk_bidirectional">Carries characters that reverse the text</string>
    <string name="risk_bidirectional_body">Invisible characters change the order in which text reads. They make a file that installs look like a picture.</string>
    <string name="risk_unusual_port">Listens on an unusual port</string>
    <string name="risk_unusual_port_body">The server does not answer on the usual port for the protocol.</string>
    <string name="risk_malformed">The address is malformed</string>
    <string name="risk_malformed_body">The server or the port is not valid, so no browser could open it. It is usually a broken code, or one crafted to confuse.</string>

    <string name="warning_risky_destination">The destination has findings</string>
    <string name="warning_risky_destination_body">Each one is explained below.</string>
    <string name="warning_unknown_network">This is someone else\'s network</string>
    <string name="warning_unknown_network_body">Whoever runs a network sees any traffic that is not encrypted, and can redirect it elsewhere.</string>
    <string name="warning_weak_network">Weak encryption, or none</string>
    <string name="warning_weak_network_body">An open network, or one on WEP, protects nothing: anyone nearby can read what goes through it.</string>
    <string name="warning_contact_url">The contact carries an address with findings</string>
    <string name="warning_contact_url_body">Saving the contact saves that address too.</string>
    <string name="warning_prepared_message">The message is already written</string>
    <string name="warning_prepared_message_body">The SMS text came inside the code. Sending it may cost money, and the number may be a premium-rate one.</string>

