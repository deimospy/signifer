    <string name="about_title">About Signifer</string>
    <string name="about_version">Version %1$s (%2$d)</string>
    <string name="about_what">QR and barcodes: reads 20 types, creates 13. Instant, lightweight, private.</string>
    <string name="about_offline">Works without internet</string>
    <string name="about_offline_body">The app asks for no network permission, so Android will not let it connect even if it wanted to. It is not a promise: the system enforces it.</string>
    <string name="about_no_tracking">It does not follow you</string>
    <string name="about_no_tracking_body">Nothing you scan leaves the phone. There are no statistics, not even anonymous ones.</string>
    <string name="about_no_ads">No ads, no purchases</string>
    <string name="about_no_ads_body">There is no paid version and no locked features.</string>
    <string name="about_no_storage">It does not look at your photos</string>
    <string name="about_no_storage_body">When you read from an image, you pick it yourself in the system picker and the app only receives that one.</string>
