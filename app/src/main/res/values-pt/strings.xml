    <string name="risk_blocked_scheme">O esquema pode executar código</string>
    <string name="risk_blocked_scheme_body">Este endereço não abre uma página: pede ao sistema que execute algo. O Signifer não o entrega; dá para copiar e examinar.</string>
    <string name="risk_unknown_scheme">Esquema fora da lista</string>
    <string name="risk_unknown_scheme_body">A lista de esquemas que podem ser abertos é fechada. O que não está nela é bloqueado, em vez de manter uma lista de proibidos que sempre fica atrás do que aparecer amanhã.</string>
    <string name="risk_insecure_transport">Viaja sem criptografia</string>
    <string name="risk_insecure_transport_body">Começa com http, não https. Quem compartilha a rede pode ler e alterar o que for enviado.</string>
    <string name="risk_embedded_credentials">Leva usuário e senha dentro</string>
    <string name="risk_embedded_credentials_body">O endereço inclui credenciais antes do servidor. É a forma clássica de disfarçá-lo: o que vem antes do arroba não é aonde se chega.</string>
    <string name="risk_missing_host">Não diz a que servidor vai</string>
    <string name="risk_missing_host_body">O endereço não tem servidor, então não há destino a conferir.</string>
    <string name="risk_loopback_host">Aponta para este mesmo telefone</string>
    <string name="risk_loopback_host_body">O destino é o próprio aparelho. Um código colado na rua não tem motivo para pedir isso.</string>
    <string name="risk_private_network">Aponta para a rede local</string>
    <string name="risk_private_network_body">Leva a um equipamento da rede em que se está agora: um roteador, uma câmera, um painel de administração.</string>
    <string name="risk_raw_ip">O servidor é um número, não um nome</string>
    <string name="risk_raw_ip_body">Um endereço IP em vez de um domínio impede saber de quem é o servidor.</string>
    <string name="risk_confusable_host">O nome do servidor pode estar disfarçado</string>
    <string name="risk_confusable_host_body">Usa punycode ou mistura alfabetos. Há letras de outros alfabetos idênticas às latinas: um «а» cirílico em apple.com parece igual e leva a outro lugar.</string>
    <string name="risk_excessive_subdomains">Encadeia subdomínios</string>
    <string name="risk_excessive_subdomains_body">Um nome longo com muitos pontos faz o começo parecer o domínio real. Quem decide é o do final.</string>
    <string name="risk_shortened">O destino real está escondido</string>
    <string name="risk_shortened_body">É um encurtador: o endereço que se vê não é aonde se chega. O Signifer não o resolve porque não tem rede, então o destino só aparece ao abrir.</string>
    <string name="risk_executable">Baixa algo que instala ou executa</string>
    <string name="risk_executable_body">O link termina em um arquivo de instalação. Um código colado na rua que instala um aplicativo é a fraude mais barata que existe.</string>
    <string name="risk_bidirectional">Leva caracteres que invertem o texto</string>
    <string name="risk_bidirectional_body">Há caracteres invisíveis que mudam a ordem em que o texto é lido. Servem para um arquivo que instala parecer uma imagem.</string>
    <string name="risk_unusual_port">Escuta em uma porta incomum</string>
    <string name="risk_unusual_port_body">O servidor não atende na porta habitual do protocolo.</string>

    <string name="warning_risky_destination">O destino tem achados</string>
    <string name="warning_risky_destination_body">Cada um está explicado abaixo.</string>
    <string name="warning_unknown_network">É uma rede alheia</string>
    <string name="warning_unknown_network_body">Quem administra uma rede vê o tráfego que não vai criptografado e pode desviá-lo para outro lugar.</string>
    <string name="warning_weak_network">A criptografia é fraca, ou não existe</string>
    <string name="warning_weak_network_body">Uma rede aberta ou com WEP não protege nada: qualquer pessoa por perto pode ler o que passa por ela.</string>
    <string name="warning_contact_url">O contato traz um endereço com achados</string>
    <string name="warning_contact_url_body">Salvar o contato salva também esse endereço.</string>
    <string name="warning_prepared_message">A mensagem já vem escrita</string>
    <string name="warning_prepared_message_body">O texto do SMS estava dentro do código. Enviá-lo pode custar dinheiro, e o número pode ser de tarifa especial.</string>

