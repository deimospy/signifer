    <string name="risk_blocked_scheme">Schemat może uruchomić kod</string>
    <string name="risk_blocked_scheme_body">Ten adres nie otwiera strony: prosi system o uruchomienie czegoś. Signifer go nie przekazuje; można go skopiować i obejrzeć.</string>
    <string name="risk_unknown_scheme">Schematu nie ma na liście</string>
    <string name="risk_unknown_scheme_body">Lista schematów, które można otworzyć, jest zamknięta. Wszystko, czego na niej nie ma, jest blokowane, zamiast prowadzić listę zakazanych, która zawsze nie nadąża za tym, co pojawi się jutro.</string>
    <string name="risk_insecure_transport">Przesyłane bez szyfrowania</string>
    <string name="risk_insecure_transport_body">Adres zaczyna się od http, a nie od https. Każdy w tej samej sieci może odczytać i zmienić to, co jest wysyłane.</string>
    <string name="risk_embedded_credentials">Zawiera nazwę użytkownika i hasło</string>
    <string name="risk_embedded_credentials_body">Adres zawiera dane logowania przed serwerem. To klasyczny sposób maskowania: to, co stoi przed znakiem @, nie jest miejscem docelowym.</string>
    <string name="risk_missing_host">Nie podano serwera</string>
    <string name="risk_missing_host_body">Adres nie ma serwera, więc nie ma celu do sprawdzenia.</string>
    <string name="risk_loopback_host">Wskazuje na ten telefon</string>
    <string name="risk_loopback_host_body">Celem jest samo urządzenie. Kod naklejony na ulicy nie ma powodu, by o to prosić.</string>
    <string name="risk_private_network">Wskazuje na sieć lokalną</string>
    <string name="risk_private_network_body">Prowadzi do urządzenia w sieci, z którą masz teraz połączenie: routera, kamery, panelu administracyjnego.</string>
    <string name="risk_raw_ip">Serwer to liczba, nie nazwa</string>
    <string name="risk_raw_ip_body">Adres IP zamiast domeny uniemożliwia ustalenie, do kogo należy serwer.</string>
    <string name="risk_confusable_host">Nazwa serwera może być zamaskowana</string>
    <string name="risk_confusable_host_body">Używa punycode albo miesza alfabety. Litery z innych alfabetów wyglądają identycznie jak łacińskie: cyrylickie „а” w apple.com wygląda tak samo i prowadzi gdzie indziej.</string>
    <string name="risk_excessive_subdomains">Łączy wiele subdomen</string>
    <string name="risk_excessive_subdomains_body">Długa nazwa z wieloma kropkami sprawia, że początek wygląda jak prawdziwa domena. Liczy się jednak końcówka.</string>
    <string name="risk_shortened">Prawdziwy cel jest ukryty</string>
    <string name="risk_shortened_body">To skrócony link: widoczny adres nie jest tym, pod który trafisz. Signifer nie może go rozwinąć, bo nie ma dostępu do sieci, więc cel widać dopiero po otwarciu.</string>
    <string name="risk_executable">Pobiera coś, co się instaluje lub uruchamia</string>
    <string name="risk_executable_body">Link kończy się plikiem instalacyjnym. Kod naklejony na ulicy, który instaluje aplikację, to najtańsze oszustwo, jakie istnieje.</string>
    <string name="risk_bidirectional">Zawiera znaki odwracające tekst</string>
    <string name="risk_bidirectional_body">Niewidoczne znaki zmieniają kolejność czytania tekstu. Dzięki nim plik instalacyjny wygląda jak obraz.</string>
    <string name="risk_unusual_port">Nasłuchuje na nietypowym porcie</string>
    <string name="risk_unusual_port_body">Serwer nie odpowiada na zwykłym porcie tego protokołu.</string>
    <string name="risk_malformed">Adres jest nieprawidłowy</string>
    <string name="risk_malformed_body">Serwer lub port są nieprawidłowe, więc żadna przeglądarka nie mogłaby otworzyć tego adresu. Zwykle to uszkodzony kod albo kod przygotowany, by wprowadzić w błąd.</string>
    <string name="warning_risky_destination">Cel budzi zastrzeżenia</string>
    <string name="warning_risky_destination_body">Każde z nich wyjaśniono poniżej.</string>
    <string name="warning_unknown_network">To cudza sieć</string>
    <string name="warning_unknown_network_body">Kto zarządza siecią, widzi cały nieszyfrowany ruch i może go przekierować.</string>
    <string name="warning_weak_network">Słabe szyfrowanie lub jego brak</string>
    <string name="warning_weak_network_body">Sieć otwarta lub z WEP niczego nie chroni: każdy w pobliżu może odczytać to, co przez nią przechodzi.</string>
    <string name="warning_contact_url">Kontakt zawiera adres budzący zastrzeżenia</string>
    <string name="warning_contact_url_body">Zapisanie kontaktu zapisze też ten adres.</string>
    <string name="warning_prepared_message">Wiadomość jest już napisana</string>
    <string name="warning_prepared_message_body">Treść SMS-a była w kodzie. Wysłanie go może kosztować, a numer może być numerem o podwyższonej opłacie.</string>
