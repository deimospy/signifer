    <string name="risk_blocked_scheme">Le schéma peut exécuter du code</string>
    <string name="risk_blocked_scheme_body">Cette adresse n\'ouvre pas une page\u00A0: elle demande au système d\'exécuter quelque chose. Signifer ne la transmet pas\u00A0; vous pouvez la copier et l\'examiner.</string>
    <string name="risk_unknown_scheme">Schéma hors de la liste</string>
    <string name="risk_unknown_scheme_body">La liste des schémas autorisés est fermée. Tout ce qui n\'y figure pas est bloqué, plutôt que de tenir une liste d\'interdits toujours en retard sur ce qui apparaîtra demain.</string>
    <string name="risk_insecure_transport">Circule sans chiffrement</string>
    <string name="risk_insecure_transport_body">L\'adresse commence par http et non par https. Toute personne sur le même réseau peut lire et modifier ce qui est envoyé.</string>
    <string name="risk_embedded_credentials">Contient un identifiant et un mot de passe</string>
    <string name="risk_embedded_credentials_body">L\'adresse inclut des identifiants avant le serveur. C\'est la ruse classique pour la déguiser\u00A0: ce qui précède l\'arobase n\'est pas la destination.</string>
    <string name="risk_missing_host">Aucun serveur indiqué</string>
    <string name="risk_missing_host_body">L\'adresse n\'a pas de serveur, il n\'y a donc aucune destination à vérifier.</string>
    <string name="risk_loopback_host">Pointe vers ce téléphone</string>
    <string name="risk_loopback_host_body">La destination est l\'appareil lui-même. Un code collé dans la rue n\'a aucune raison de demander cela.</string>
    <string name="risk_private_network">Pointe vers le réseau local</string>
    <string name="risk_private_network_body">Elle mène à un appareil du réseau auquel vous êtes connecté en ce moment\u00A0: un routeur, une caméra, une interface d\'administration.</string>
    <string name="risk_raw_ip">Le serveur est un numéro, pas un nom</string>
    <string name="risk_raw_ip_body">Une adresse IP au lieu d\'un nom de domaine empêche de savoir à qui appartient le serveur.</string>
    <string name="risk_confusable_host">Le nom du serveur est peut-être déguisé</string>
    <string name="risk_confusable_host_body">Il utilise le punycode ou mélange des alphabets. Certaines lettres d\'autres alphabets sont identiques aux lettres latines\u00A0: un «\u00A0а\u00A0» cyrillique dans apple.com a le même aspect et mène ailleurs.</string>
    <string name="risk_excessive_subdomains">Enchaîne les sous-domaines</string>
    <string name="risk_excessive_subdomains_body">Un nom long avec beaucoup de points donne au début l\'apparence du vrai domaine. C\'est la fin qui compte.</string>
    <string name="risk_shortened">La vraie destination est cachée</string>
    <string name="risk_shortened_body">C\'est un raccourcisseur de liens\u00A0: l\'adresse affichée n\'est pas celle où l\'on arrive. Signifer ne peut pas la résoudre, car il n\'a pas de réseau\u00A0; la destination n\'apparaît qu\'à l\'ouverture.</string>
    <string name="risk_executable">Télécharge quelque chose qui s\'installe ou s\'exécute</string>
    <string name="risk_executable_body">Le lien se termine par un fichier d\'installation. Un code collé dans la rue qui installe une application est la fraude la moins chère qui soit.</string>
    <string name="risk_bidirectional">Contient des caractères qui inversent le texte</string>
    <string name="risk_bidirectional_body">Des caractères invisibles changent l\'ordre de lecture du texte. Ils font passer un fichier qui s\'installe pour une image.</string>
    <string name="risk_unusual_port">Écoute sur un port inhabituel</string>
    <string name="risk_unusual_port_body">Le serveur ne répond pas sur le port habituel du protocole.</string>
    <string name="risk_malformed">L\'adresse est mal formée</string>
    <string name="risk_malformed_body">Le serveur ou le port n\'est pas valide, aucun navigateur ne pourrait donc l\'ouvrir. C\'est souvent un code abîmé ou conçu pour tromper.</string>
    <string name="warning_risky_destination">La destination présente des alertes</string>
    <string name="warning_risky_destination_body">Chacune est expliquée ci-dessous.</string>
    <string name="warning_unknown_network">C\'est le réseau de quelqu\'un d\'autre</string>
    <string name="warning_unknown_network_body">Qui gère un réseau voit tout le trafic non chiffré et peut le rediriger ailleurs.</string>
    <string name="warning_weak_network">Chiffrement faible ou absent</string>
    <string name="warning_weak_network_body">Un réseau ouvert ou en WEP ne protège rien\u00A0: n\'importe qui à proximité peut lire ce qui y passe.</string>
    <string name="warning_contact_url">Le contact contient une adresse avec des alertes</string>
    <string name="warning_contact_url_body">Enregistrer le contact enregistre aussi cette adresse.</string>
    <string name="warning_prepared_message">Le message est déjà rédigé</string>
    <string name="warning_prepared_message_body">Le texte du SMS se trouvait dans le code. L\'envoyer peut coûter de l\'argent, et le numéro peut être surtaxé.</string>
