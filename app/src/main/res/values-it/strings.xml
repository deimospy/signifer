    <string name="risk_blocked_scheme">Lo schema può eseguire codice</string>
    <string name="risk_blocked_scheme_body">Questo indirizzo non apre una pagina: chiede al sistema di eseguire qualcosa. Signifer non lo inoltra; puoi copiarlo ed esaminarlo.</string>
    <string name="risk_unknown_scheme">Schema non in elenco</string>
    <string name="risk_unknown_scheme_body">L\'elenco degli schemi che si possono aprire è chiuso. Tutto ciò che non c\'è viene bloccato, invece di tenere un elenco di divieti sempre in ritardo su ciò che comparirà domani.</string>
    <string name="risk_insecure_transport">Viaggia senza cifratura</string>
    <string name="risk_insecure_transport_body">Inizia con http, non con https. Chi condivide la rete può leggere e modificare ciò che viene inviato.</string>
    <string name="risk_embedded_credentials">Contiene nome utente e password</string>
    <string name="risk_embedded_credentials_body">L\'indirizzo include delle credenziali prima del server. È il trucco classico per camuffarlo: ciò che precede la chiocciola non è la destinazione.</string>
    <string name="risk_missing_host">Nessun server indicato</string>
    <string name="risk_missing_host_body">L\'indirizzo non ha un server, quindi non c\'è una destinazione da controllare.</string>
    <string name="risk_loopback_host">Punta a questo telefono</string>
    <string name="risk_loopback_host_body">La destinazione è il dispositivo stesso. Un codice attaccato per strada non ha motivo di chiederlo.</string>
    <string name="risk_private_network">Punta alla rete locale</string>
    <string name="risk_private_network_body">Porta a un dispositivo della rete a cui sei connesso in questo momento: un router, una videocamera, un pannello di amministrazione.</string>
    <string name="risk_raw_ip">Il server è un numero, non un nome</string>
    <string name="risk_raw_ip_body">Un indirizzo IP al posto di un dominio impedisce di sapere di chi è il server.</string>
    <string name="risk_confusable_host">Il nome del server potrebbe essere camuffato</string>
    <string name="risk_confusable_host_body">Usa il punycode o mescola alfabeti. Alcune lettere di altri alfabeti sono identiche a quelle latine: una «а» cirillica in apple.com appare uguale e porta altrove.</string>
    <string name="risk_excessive_subdomains">Concatena sottodomini</string>
    <string name="risk_excessive_subdomains_body">Un nome lungo con molti punti fa sembrare l\'inizio il dominio reale. Quello che conta è la parte finale.</string>
    <string name="risk_shortened">La vera destinazione è nascosta</string>
    <string name="risk_shortened_body">È un link accorciato: l\'indirizzo che vedi non è quello a cui arrivi. Signifer non può risolverlo perché non ha rete, quindi la destinazione si vede solo aprendolo.</string>
    <string name="risk_executable">Scarica qualcosa che si installa o si esegue</string>
    <string name="risk_executable_body">Il link termina con un file di installazione. Un codice attaccato per strada che installa un\'app è la truffa più economica che esista.</string>
    <string name="risk_bidirectional">Contiene caratteri che invertono il testo</string>
    <string name="risk_bidirectional_body">Alcuni caratteri invisibili cambiano l\'ordine in cui si legge il testo. Servono a far sembrare un\'immagine un file che si installa.</string>
    <string name="risk_unusual_port">Ascolta su una porta insolita</string>
    <string name="risk_unusual_port_body">Il server non risponde sulla porta abituale del protocollo.</string>
    <string name="risk_malformed">L\'indirizzo è malformato</string>
    <string name="risk_malformed_body">Il server o la porta non sono validi, quindi nessun browser potrebbe aprirlo. Di solito è un codice rovinato o preparato per confondere.</string>
    <string name="warning_risky_destination">La destinazione ha delle segnalazioni</string>
    <string name="warning_risky_destination_body">Qui sotto trovi la spiegazione di ciascuna.</string>
    <string name="warning_unknown_network">È la rete di qualcun altro</string>
    <string name="warning_unknown_network_body">Chi gestisce una rete vede il traffico non cifrato e può deviarlo altrove.</string>
    <string name="warning_weak_network">Cifratura debole o assente</string>
    <string name="warning_weak_network_body">Una rete aperta o con WEP non protegge nulla: chiunque nelle vicinanze può leggere ciò che vi passa.</string>
    <string name="warning_contact_url">Il contatto contiene un indirizzo con segnalazioni</string>
    <string name="warning_contact_url_body">Salvando il contatto si salva anche quell\'indirizzo.</string>
    <string name="warning_prepared_message">Il messaggio è già scritto</string>
    <string name="warning_prepared_message_body">Il testo dell\'SMS era nel codice. Inviarlo può costare, e il numero potrebbe essere a tariffa maggiorata.</string>
