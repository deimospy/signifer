    <string name="risk_blocked_scheme">El esquema puede ejecutar código</string>
    <string name="risk_blocked_scheme_body">Esta dirección no abre una página: le pide al sistema que ejecute algo. Signifer no la entrega; se puede copiar y mirar.</string>
    <string name="risk_unknown_scheme">Esquema fuera de la lista</string>
    <string name="risk_unknown_scheme_body">La lista de esquemas que se pueden abrir es cerrada. Lo que no figura en ella se bloquea, en vez de mantener una lista de prohibidos que siempre va por detrás de lo que aparezca mañana.</string>
    <string name="risk_insecure_transport">Viaja sin cifrar</string>
    <string name="risk_insecure_transport_body">Empieza por http, no por https. Quien comparta la red puede leer y cambiar lo que se envíe.</string>
    <string name="risk_embedded_credentials">Lleva usuario y clave dentro</string>
    <string name="risk_embedded_credentials_body">La dirección incluye credenciales antes del servidor. Es la forma clásica de disfrazarlo: lo que va antes de la arroba no es adónde se llega.</string>
    <string name="risk_missing_host">No dice a qué servidor va</string>
    <string name="risk_missing_host_body">La dirección no tiene servidor, así que no hay destino que comprobar.</string>
    <string name="risk_loopback_host">Apunta a este mismo teléfono</string>
    <string name="risk_loopback_host_body">El destino es el propio dispositivo. Un código pegado en la calle no tiene motivo para pedir eso.</string>
    <string name="risk_private_network">Apunta a la red local</string>
    <string name="risk_private_network_body">Lleva a un equipo de la red a la que se esté conectado ahora mismo: un router, una cámara, un panel de administración.</string>
    <string name="risk_raw_ip">El servidor es un número, no un nombre</string>
    <string name="risk_raw_ip_body">Una dirección IP en lugar de un dominio impide saber de quién es el servidor.</string>
    <string name="risk_confusable_host">El nombre del servidor puede estar disfrazado</string>
    <string name="risk_confusable_host_body">Usa punycode o mezcla alfabetos. Hay letras de otros alfabetos idénticas a las latinas: una «а» cirílica en apple.com se ve igual y lleva a otro sitio.</string>
    <string name="risk_excessive_subdomains">Encadena subdominios</string>
    <string name="risk_excessive_subdomains_body">Un nombre largo con muchos puntos sirve para que el principio parezca el dominio real. El que decide es el del final.</string>
    <string name="risk_shortened">El destino real está escondido</string>
    <string name="risk_shortened_body">Es un acortador: la dirección que se ve no es a la que se llega. Signifer no la resuelve porque no tiene red, así que el destino solo se ve al abrirlo.</string>
    <string name="risk_executable">Descarga algo que se instala o se ejecuta</string>
    <string name="risk_executable_body">El enlace termina en un archivo de instalación. Un código pegado en la calle que instala una aplicación es el fraude más barato que existe.</string>
    <string name="risk_bidirectional">Lleva caracteres que invierten el texto</string>
    <string name="risk_bidirectional_body">Hay caracteres invisibles que cambian el orden en que se lee lo escrito. Sirven para que un archivo que se instala parezca una imagen.</string>
    <string name="risk_unusual_port">Escucha en un puerto poco común</string>
    <string name="risk_unusual_port_body">El servidor no atiende en el puerto habitual del protocolo.</string>

    <string name="warning_risky_destination">El destino tiene hallazgos</string>
    <string name="warning_risky_destination_body">Debajo está cada uno explicado.</string>
    <string name="warning_unknown_network">Es una red ajena</string>
    <string name="warning_unknown_network_body">Quien administra una red ve el tráfico que no va cifrado y puede desviarlo a otro sitio.</string>
    <string name="warning_weak_network">El cifrado es débil o no hay</string>
    <string name="warning_weak_network_body">Una red abierta o con WEP no protege nada: cualquiera cerca puede leer lo que pase por ella.</string>
    <string name="warning_contact_url">El contacto trae una dirección con hallazgos</string>
    <string name="warning_contact_url_body">Guardar el contacto guarda también esa dirección.</string>
    <string name="warning_prepared_message">El mensaje ya viene escrito</string>
    <string name="warning_prepared_message_body">El texto del SMS estaba dentro del código. Enviarlo puede costar dinero, y el número puede ser de tarificación especial.</string>

