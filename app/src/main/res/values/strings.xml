    <string name="about_title">Acerca de Signifer</string>
    <string name="about_version">Versión %1$s (%2$d)</string>
    <string name="about_what">Lee veinte tipos de código y crea trece. Todo pasa dentro del teléfono.</string>
    <string name="about_offline">Funciona sin internet</string>
    <string name="about_offline_body">La aplicación no pide permiso de red, así que Android no la deja conectarse aunque quisiera. No es una promesa: es el sistema el que lo impide.</string>
    <string name="about_no_tracking">No te sigue</string>
    <string name="about_no_tracking_body">Nada de lo que escaneás sale del teléfono. No hay estadísticas, ni siquiera anónimas.</string>
    <string name="about_no_ads">Sin anuncios ni compras</string>
    <string name="about_no_ads_body">No hay versión de pago ni funciones bloqueadas.</string>
    <string name="about_no_storage">No mira tus fotos</string>
    <string name="about_no_storage_body">Cuando leés desde una imagen, la elegís vos en el selector del sistema y la aplicación solo recibe esa.</string>
